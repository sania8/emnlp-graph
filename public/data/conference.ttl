    nk:summary "Widening NLP is a long-running diversity and inclusion workshop series within the ACL community. WiNLP exists because many barriers to participation are upstream of paper quality: unequal access to mentorship and professional networks, reduced opportunities for visibility and senior feedback, financ" ;
    nk:talkType "Workshop" ;
    nk:time "Wednesday, October 28th 9:00–17:30" ;
    nk:url "https://winlp-workshop.github.io/events/winlp-2026/call-for-papers/" .

nk:talk-workshop-third-workshop-on-uncertainty-aware-nlp a nk:Talk ;
    rdfs:label "Third Workshop on Uncertainty-Aware NLP (UncertaiNLP)" ;
    nk:about nk:topic-cognition-brain,
        nk:topic-evaluation,
        nk:topic-multimodal,
        nk:topic-reasoning-math,
        nk:topic-uncertainty ;
    nk:inSession nk:session-workshops-29 ;
    nk:room "F6" ;
    nk:summary "Human language is inherently ambiguous and variable, yet much of NLP research assumes that uncertainty can and should be resolved. This workshop provides a forum for research that models and evaluates uncertainty arising from language, data, and modeling choices." ;
    nk:talkType "Workshop" ;
    nk:time "Thursday, October 29th 9:00–17:30" ;
    nk:url "https://uncertainlp.github.io/" .

nk:talk-workshop-workshop-on-document-intelligence-and-u a nk:Talk ;

    nk:room "F9-10" ;
    nk:summary "SALMA (Speech and Audio Language Models) workshop investigates speech and audio as first-class modalities for large language models (LLMs), addressing challenges that are underexplored in mainstream LLM research. Unlike text, audio presents continuous temporal structure, multi-scale semantics, paral" ;
    nk:talkType "Workshop" ;
    nk:time "Wednesday, October 28th 9:00–17:30" ;
    nk:url "https://salma-workshop.github.io/salma-2026/" .

nk:talk-workshop-tenth-widening-nlp-workshop-winlp a nk:Talk ;
